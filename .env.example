# Copy to .env (or set in your hosting provider) — never commit real values.

# Origin of the Express API that answers /api/contact.
# Next.js proxies /api/* here via the rewrite in frontend/next.config.mjs.
# Required in every deployed environment; local dev falls back to http://localhost:4000.
API_ORIGIN=https://api.your-domain.com

# Port the Express API listens on (backend/index.js).
API_PORT=4000

# Contact delivery — wire these up at the integration point in backend/index.js.
CONTACT_TO_EMAIL=hello@your-domain.com
RESEND_API_KEY=
